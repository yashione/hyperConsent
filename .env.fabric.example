# Copy this file to .env.fabric or export these values when running the
# Node gateway against the local Hyperledger Fabric test network.

FABRIC_MOCK=false
FABRIC_MSP_ID=Org1MSP
FABRIC_CHANNEL=mychannel
FABRIC_CHAINCODE=consentcc
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_PEER_HOST_ALIAS=peer0.org1.example.com

# Host/manual gateway paths.
FABRIC_CERT_PATH=../../blockchain/test-network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/signcerts/User1@org1.example.com-cert.pem
FABRIC_KEY_PATH=../../blockchain/test-network/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/keystore/priv_sk
FABRIC_TLS_CERT_PATH=../../blockchain/test-network/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt

# Docker gateway paths. Use these values when running with
# docker/docker-compose.fabric.yml.
# FABRIC_CERT_PATH=/fabric/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/signcerts/User1@org1.example.com-cert.pem
# FABRIC_KEY_PATH=/fabric/organizations/peerOrganizations/org1.example.com/users/User1@org1.example.com/msp/keystore/priv_sk
# FABRIC_TLS_CERT_PATH=/fabric/organizations/peerOrganizations/org1.example.com/peers/peer0.org1.example.com/tls/ca.crt
# FABRIC_PEER_ENDPOINT=host.docker.internal:7051
